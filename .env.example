# LLM Provider Configuration
# Options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
MODEL_NAME=gpt-4o-mini

# API Keys (Optional - mock mode works out of the box with zero setup)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage & Retrieval Settings
DB_PATH=data/companion_memory.db
DECAY_HALF_LIFE_HOURS=72.0
MAX_RETRIEVED_MEMORIES=5
MIN_SIMILARITY_THRESHOLD=0.15
